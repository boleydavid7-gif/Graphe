{
  "name": "@office-engine/writer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:wasm": "node --test tests/wasm.test.mjs tests/docx-wasm.test.mjs tests/layout-wasm.test.mjs tests/step7-wasm.test.mjs tests/step75-wasm.test.mjs tests/docx-relationships-wasm.test.mjs tests/touch-selection-wasm.test.mjs tests/phase2-compatibility-wasm.test.mjs",
    "test:build": "node --test tests/cloudflare-build.test.mjs",
    "test:browser": "playwright test",
    "build": "npm run build:wasm && npm run typecheck && vite build",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": { "minimatch": "11.0.8" }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
